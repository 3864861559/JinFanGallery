<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/video_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/video_bg">

    <SurfaceView
        android:id="@+id/video_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- 顶部：返回 + 日期 -->
    <LinearLayout
        android:id="@+id/video_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:paddingHorizontal="12dp"
        android:paddingTop="36dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_video_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_scrim"
            android:padding="8dp"
            android:src="@drawable/ic_video_back"
            android:contentDescription="@string/video_back" />

        <TextView
            android:id="@+id/tv_video_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#F2FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 底部：播放条 + 功能条 -->
    <LinearLayout
        android:id="@+id/video_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_video_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/btn_video_play"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@null"
                android:padding="10dp"
                android:src="@drawable/ic_video_play"
                android:contentDescription="@string/video_play" />

            <SeekBar
                android:id="@+id/seek_video"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:progressBackgroundTint="@color/video_track"
                android:progressTint="@color/video_icon"
                android:thumbTint="@color/video_icon"
                android:splitTrack="false"
                android:paddingHorizontal="6dp" />

            <ImageButton
                android:id="@+id/btn_video_mute"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@null"
                android:padding="10dp"
                android:src="@drawable/ic_video_volume"
                android:contentDescription="@string/video_mute" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_video_pill"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <LinearLayout
                android:id="@+id/act_video_send"
                style="@style/VideoActionItem">

                <ImageView
                    style="@style/VideoActionIcon"
                    android:src="@drawable/ic_video_share" />

                <TextView style="@style/VideoActionLabel" android:text="@string/video_send" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/act_video_clip"
                style="@style/VideoActionItem">

                <ImageView
                    style="@style/VideoActionIcon"
                    android:src="@drawable/ic_video_clip" />

                <TextView
                    style="@style/VideoActionLabel"
                    android:text="@string/video_clip"
                    android:textColor="@color/video_icon_dim" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/act_video_fav"
                style="@style/VideoActionItem">

                <ImageView
                    android:id="@+id/ic_video_fav"
                    style="@style/VideoActionIcon"
                    android:src="@drawable/ic_video_heart" />

                <TextView style="@style/VideoActionLabel" android:text="@string/video_fav" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/act_video_delete"
                style="@style/VideoActionItem">

                <ImageView
                    style="@style/VideoActionIcon"
                    android:src="@drawable/ic_video_delete" />

                <TextView style="@style/VideoActionLabel" android:text="@string/video_delete" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/act_video_more"
                style="@style/VideoActionItem">

                <ImageView
                    style="@style/VideoActionIcon"
                    android:src="@drawable/ic_video_more" />

                <TextView style="@style/VideoActionLabel" android:text="@string/video_more" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
